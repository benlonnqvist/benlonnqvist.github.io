source "https://rubygems.org"

# Matches the versions GitHub Pages uses, so `bundle exec jekyll serve`
# previews the site exactly as it will be published.
# Use Ruby 3.3 locally: GitHub Pages' Jekyll doesn't support Ruby 3.4+/4.x.
gem "github-pages", group: :jekyll_plugins
gem "webrick"

# Former standard-library gems that newer Rubies no longer bundle
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
